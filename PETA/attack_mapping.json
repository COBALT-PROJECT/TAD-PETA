    "SQL_Injection": {
        "att_ck_name": "Exploit Public-Facing Application",
        "att_id": "T1190",
        "contexts": {
            "Frontend": [
                {
                    "mitigation_id": "M1050.1",
                    "description": "Update WAF Input Filters (Block SQL Payload)",
                    "action": "waf --enable-rule SQLI_BLOCK",
                    "impact_level": "Low",
                    "effectiveness": "High"
                },
                {
                    "mitigation_id": "M1050.2",
                    "description": "Temporarily Isolate Frontend",
                    "action": "kubectl scale deployment frontend --replicas=0",
                    "impact_level": "Critical",
                    "effectiveness": "High"
                }
            ],
            "Database": [
                {
                    "mitigation_id": "M1050.3",
                    "description": "Terminate Active DB Sessions from Affected Pod",
                    "action": "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE client_addr = '$POD_IP';",
                    "impact_level": "High",
                    "effectiveness": "Medium"
                },
                {
                    "mitigation_id": "M1050.4",
                    "description": "Enforce SSL Only and Drop Unencrypted Connections",
                    "action": "postgres --ssl=on --require-secure-transport",
                    "impact_level": "Medium",
                    "effectiveness": "Low"
                }
            ]
        }
    },
