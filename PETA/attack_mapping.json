{
  "Denial_of_Service": {
    "att_ck_name": "Network Denial of Service: Reflection Amplification",
    "att_id": "T1498.002",
    "contexts": {
      "Frontend": [
        {
          "mitigation_id": "M1037.F1",
          "description": "Rate limit at nginx",
          "action": "nginx -s reload after limit_req_zone $binary_remote_addr zone=ddos:10m rate=10r/s",
          "impact_level": "Low",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.F2",
          "description": "Rate limit new conns with ufw",
          "action": "ufw limit proto tcp from any to any port 443",
          "impact_level": "Low",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.F3",
          "description": "Drop source with nftables",
          "action": "nft add rule inet filter input ip saddr $SOURCE_IP drop",
          "impact_level": "Low",
          "effectiveness": "High"
        },
        {
          "mitigation_id": "M1037.F4",
          "description": "Enable upstream scrubbing",
          "action": "curl -X POST api.cdn.provider/scrubbing?enable=true",
          "impact_level": "Medium",
          "effectiveness": "High"
        }
      ],
      "Database": [
        {
          "mitigation_id": "M1037.D1",
          "description": "Restrict DB port to app subnet",
          "action": "ufw delete allow 3306 && ufw allow from 10.163.1.0/24 to any port 3306",
          "impact_level": "Medium",
          "effectiveness": "High"
        },
        {
          "mitigation_id": "M1037.D2",
          "description": "Cap concurrent connections",
          "action": "mysql -e \"SET GLOBAL max_connections=150;\"",
          "impact_level": "Medium",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.D3",
          "description": "Throttle source at host firewall",
          "action": "iptables -A INPUT -s $SOURCE_IP -p tcp --dport 3306 -m limit --limit 20/s -j ACCEPT",
          "impact_level": "Low",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.D4",
          "description": "Stop DB service",
          "action": "systemctl stop mysql",
          "impact_level": "Critical",
          "effectiveness": "Critical"
        }
      ],
      "Compute": [
        {
          "mitigation_id": "M1037.C1",
          "description": "Rate limit NodePort range",
          "action": "iptables -A INPUT -p tcp --dport 30000:32767 -m limit --limit 50/s -j ACCEPT",
          "impact_level": "Low",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.C2",
          "description": "Drop source at node firewall",
          "action": "ufw deny from $SOURCE_IP",
          "impact_level": "Low",
          "effectiveness": "High"
        },
        {
          "mitigation_id": "M1037.C3",
          "description": "Cordon node and drain workloads",
          "action": "kubectl cordon $NODE && kubectl drain $NODE --ignore-daemonsets",
          "impact_level": "High",
          "effectiveness": "High"
        }
      ],
      "Identity": [
        {
          "mitigation_id": "M1037.I1",
          "description": "Rate limit auth endpoint",
          "action": "nft add rule inet filter input tcp dport 8443 limit rate 20/second accept",
          "impact_level": "Low",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.I2",
          "description": "Drop source IP",
          "action": "ufw deny from $SOURCE_IP",
          "impact_level": "Low",
          "effectiveness": "High"
        },
        {
          "mitigation_id": "M1037.I3",
          "description": "Restrict IAM to internal subnet",
          "action": "ufw allow from 10.163.1.0/24 to any port 8443 && ufw deny 8443",
          "impact_level": "Medium",
          "effectiveness": "High"
        }
      ],
      "Security": [
        {
          "mitigation_id": "M1037.S1",
          "description": "Rate limit ingest endpoint",
          "action": "nft add rule inet filter input tcp dport 8002 limit rate 100/second accept",
          "impact_level": "Low",
          "effectiveness": "Medium"
        },
        {
          "mitigation_id": "M1037.S2",
          "description": "Drop source IP",
          "action": "ufw deny from $SOURCE_IP",
          "impact_level": "Low",
          "effectiveness": "High"
        },
        {
          "mitigation_id": "M1037.S3",
          "description": "Restrict service to management subnet",
          "action": "ufw allow from 10.163.1.0/24 to any port 8002 && ufw deny 8002",
          "impact_level": "Medium",
          "effectiveness": "High"
        }
      ]
    }
  },
